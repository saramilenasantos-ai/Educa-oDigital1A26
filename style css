@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root{
    --bg: #0f172a;
    --card: #1e293b;
    --card-hover: #334155;
    --primary: #38bdf8;
    --secondary: #06b6d4;
    --text: #f8fafc;
    --text-light: #94a3b8;
}

body{
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg,#020617,#0f172a,#1e293b);
    color: var(--text);
    min-height: 100vh;
}

/* HEADER */

header{
    text-align: center;
    padding: 70px 20px;
    background: rgba(255,255,255,0.03);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

header h1{
    font-size: 4rem;
    margin-bottom: 15px;
    background: linear-gradient(
        90deg,
        #38bdf8,
        #06b6d4,
        #22d3ee
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

header p{
    color: var(--text-light);
    font-size: 1.1rem;
}

/* MAIN */

main{
    width: 90%;
    max-width: 1200px;
    margin: 50px auto;
    display: grid;
    gap: 35px;
}

/* CARDS */

article{
    background: var(--card);
    border-radius: 25px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 350px 1fr;
    box-shadow: 0 10px 30px rgba(0,0,0,.3);
    transition: .4s;
    border: 1px solid rgba(255,255,255,.05);
}

article:hover{
    transform: translateY(-8px);
    background: var(--card-hover);
    box-shadow: 0 20px 40px rgba(0,0,0,.5);
}

article img{
    width: 100%;
    height: 100%;
    object-fit: cover;
}

article div{
    padding: 30px;
}

article h2{
    color: var(--primary);
    margin-bottom: 12px;
    font-size: 1.8rem;
}

.artigo-autor{
    color: #22d3ee;
    font-weight: 500;
    margin-bottom: 15px;
}

.artigo-fonte{
    margin-top: 15px;
    font-size: .9rem;
    color: #94a3b8;
    font-style: italic;
}

article p{
    line-height: 1.8;
    color: #e2e8f0;
}

/* BOTÕES */

button{
    margin-top: 20px;
    margin-right: 10px;
    border: none;
    padding: 12px 20px;
    border-radius: 50px;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 600;
    transition: .3s;
    color: white;
}

button:first-of-type{
    background: linear-gradient(45deg,#ef4444,#f97316);
}

button:last-of-type{
    background: linear-gradient(45deg,#2563eb,#06b6d4);
}

button:hover{
    transform: scale(1.08);
    box-shadow: 0 8px 20px rgba(0,0,0,.3);
}

button span{
    margin-left: 5px;
}

/* EFEITO DE ENTRADA */

article{
    animation: surgir .8s ease;
}

@keyframes surgir{
    from{
        opacity: 0;
        transform: translateY(40px);
    }

    to{
        opacity: 1;
        transform: translateY(0);
    }
}

/* SCROLLBAR */

::-webkit-scrollbar{
    width: 10px;
}

::-webkit-scrollbar-track{
    background: #0f172a;
}

::-webkit-scrollbar-thumb{
    background: linear-gradient(
        #38bdf8,
        #06b6d4
    );
    border-radius: 20px;
}

/* RESPONSIVO */

@media (max-width: 900px){

    article{
        grid-template-columns: 1fr;
    }

    article img{
        height: 250px;
    }

    header h1{
        font-size: 2.8rem;
    }
}

@media (max-width: 600px){

    header{
        padding: 50px 15px;
    }

    header h1{
        font-size: 2.2rem;
    }

    article div{
        padding: 20px;
    }

    article h2{
        font-size: 1.4rem;
    }

    button{
        width: 100%;
        margin-right: 0;
        margin-bottom: 10px;
    }
}