*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#0f172a,#1e293b,#111827);
    color:#fff;
    min-height:100vh;
}

/* Cabeçalho */

header{
    background:#111827;
    text-align:center;
    padding:60px 20px;
    border-bottom:4px solid #38bdf8;
    box-shadow:0 5px 20px rgba(0,0,0,.4);
}

header h1{
    font-size:3rem;
    color:#38bdf8;
    margin-bottom:10px;
}

header p{
    color:#cbd5e1;
    font-size:1.1rem;
}

/* Conteúdo */

main{
    width:90%;
    max-width:1200px;
    margin:40px auto;
    display:grid;
    gap:35px;
}

/* Cards */

article{
    display:flex;
    background:#1b2739;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 10px 25px rgba(0,0,0,.4);
    transition:.4s;
}

article:hover{
    transform:translateY(-8px);
    box-shadow:0 15px 35px rgba(56,189,248,.3);
}

/* Imagens */

article img{
    width:320px;
    height:260px;
    object-fit:cover;
}

/* Texto */

article div{
    padding:25px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

article h2{
    color:#38bdf8;
    margin-bottom:15px;
    font-size:1.8rem;
}

.artigo-autor{
    color:#94a3b8;
    margin-bottom:15px;
    font-style:italic;
}

article p{
    line-height:1.7;
    margin-bottom:15px;
}

.artigo-fonte{
    color:#22c55e;
    font-size:.9rem;
}

/* Botões */

button{
    margin-top:10px;
    margin-right:10px;
    padding:10px 18px;
    border:none;
    border-radius:50px;
    cursor:pointer;
    background:#0f172a;
    color:#fff;
    font-size:16px;
    transition:.3s;
}

button:hover{
    background:#38bdf8;
    color:#000;
    transform:scale(1.1);
}

/* Scrollbar */

::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-thumb{
    background:#38bdf8;
    border-radius:20px;
}

::-webkit-scrollbar-track{
    background:#111827;
}

/* Responsivo */

@media(max-width:900px){

    article{
        flex-direction:column;
    }

    article img{
        width:100%;
        height:250px;
    }

    header h1{
        font-size:2.2rem;
    }

}