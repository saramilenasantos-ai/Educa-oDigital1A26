

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#0f172a,#1e293b,#334155);
    color:#f8fafc;
    min-height:100vh;
}

/* Cabeçalho */

header{
    text-align:center;
    padding:60px 20px;
    background:rgba(255,255,255,.05);
    backdrop-filter:blur(10px);
    border-bottom:1px solid rgba(255,255,255,.1);
    box-shadow:0 8px 20px rgba(0,0,0,.3);
}

header h1{
    font-size:3rem;
    color:#38bdf8;
    margin-bottom:10px;
}

header p{
    font-size:1.2rem;
    color:#cbd5e1;
}

/* Conteúdo */

main{
    width:90%;
    max-width:1200px;
    margin:40px auto;
    display:grid;
    gap:35px;
}

/* Cards */

article{
    display:flex;
    background:#1e293b;
    border-radius:20px;
    overflow:hidden;
    box-shadow:0 15px 35px rgba(0,0,0,.35);
    transition:.4s;
}

article:hover{
    transform:translateY(-8px);
    box-shadow:0 20px 45px rgba(56,189,248,.35);
}

/* Imagens */

article img{
    width:320px;
    height:250px;
    object-fit:cover;
    transition:.5s;
}

article:hover img{
    transform:scale(1.08);
}

/* Texto */

article div{
    padding:25px;
    display:flex;
    flex-direction:column;
    justify-content:center;
}

article h2{
    color:#38bdf8;
    font-size:1.8rem;
    margin-bottom:15px;
}

.artigo-autor{
    color:#94a3b8;
    font-size:.95rem;
    margin-bottom:15px;
    font-style:italic;
}

article p{
    line-height:1.8;
    margin-bottom:15px;
}

.artigo-fonte{
    color:#fbbf24;
    font-size:.9rem;
    font-weight:600;
}

/* Botões */

button{
    margin-top:10px;
    margin-right:10px;
    padding:10px 20px;
    border:none;
    border-radius:30px;
    background:#334155;
    color:white;
    cursor:pointer;
    font-size:16px;
    transition:.3s;
}

button:hover{
    transform:scale(1.08);
    background:#38bdf8;
    color:#0f172a;
}

button:first-of-type:hover{
    background:#ef4444;
    color:white;
}

button span{
    margin-left:5px;
    font-weight:bold;
}

/* Barra colorida em cada card */

article::before{
    content:"";
    width:8px;
    background:linear-gradient(#38bdf8,#06b6d4,#3b82f6);
}

/* Scroll */

::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-track{
    background:#0f172a;
}

::-webkit-scrollbar-thumb{
    background:#38bdf8;
    border-radius:10px;
}

::-webkit-scrollbar-thumb:hover{
    background:#0ea5e9;
}

/* Responsivo */

@media (max-width:900px){

    article{
        flex-direction:column;
    }

    article img{
        width:100%;
        height:250px;
    }

    article::before{
        width:100%;
        height:8px;
    }

    header h1{
        font-size:2.2rem;
    }

    article h2{
        font-size:1.5rem;
    }

}

@media (max-width:500px){

    header{
        padding:40px 15px;
    }

    header h1{
        font-size:1.8rem;
    }

    header p{
        font-size:1rem;
    }

    article div{
        padding:18px;
    }

    button{
        width:100%;
        margin-right:0;
    }

}