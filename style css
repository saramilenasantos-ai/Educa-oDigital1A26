/* Google Fonts */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:linear-gradient(135deg,#0f172a,#1e293b,#020617);
    color:white;
    min-height:100vh;
    overflow-x:hidden;
}

/* Scroll */

::-webkit-scrollbar{
    width:10px;
}

::-webkit-scrollbar-track{
    background:#111827;
}

::-webkit-scrollbar-thumb{
    background:linear-gradient(#00d4ff,#7c3aed);
    border-radius:20px;
}

/* HEADER */

header{
    text-align:center;
    padding:70px 20px;
    background:
    linear-gradient(rgba(0,0,0,.4),rgba(0,0,0,.5)),
    linear-gradient(120deg,#2563eb,#7c3aed,#06b6d4);
    background-size:300% 300%;
    animation:gradient 8s infinite alternate;
    box-shadow:0 15px 40px rgba(0,0,0,.4);
}

@keyframes gradient{

    0%{background-position:left;}
    100%{background-position:right;}

}

header h1{
    font-size:3.5rem;
    font-weight:800;
    letter-spacing:2px;
    text-shadow:0 0 20px rgba(255,255,255,.3);
}

header p{
    margin-top:15px;
    font-size:1.2rem;
    opacity:.9;
}

/* MAIN */

main{
    width:90%;
    max-width:1200px;
    margin:50px auto;
    display:grid;
    gap:40px;
}

/* ARTICLE */

article{
    display:grid;
    grid-template-columns:320px 1fr;
    background:rgba(255,255,255,.08);
    backdrop-filter:blur(18px);
    border:1px solid rgba(255,255,255,.1);
    border-radius:25px;
    overflow:hidden;
    transition:.4s;
    position:relative;
}

article::before{
    content:"";
    position:absolute;
    width:200%;
    height:5px;
    background:linear-gradient(90deg,#00d4ff,#7c3aed,#ff0080,#00d4ff);
    top:0;
    left:-100%;
    transition:.8s;
}

article:hover::before{
    left:0;
}

article:hover{
    transform:translateY(-12px) scale(1.01);
    box-shadow:0 20px 45px rgba(0,0,0,.45);
}

/* IMAGE */

article img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.6s;
}

article:hover img{
    transform:scale(1.08);
}

/* CONTENT */

article div{
    padding:30px;
    display:flex;
    flex-direction:column;
}

article h2{
    color:#00d4ff;
    margin-bottom:15px;
    font-size:1.8rem;
}

.artigo-autor{
    color:#b3b3b3;
    font-size:.95rem;
    margin-bottom:15px;
}

article p{
    line-height:1.7;
    margin-bottom:15px;
    color:#ececec;
}

.artigo-fonte{
    color:#7dd3fc;
    font-style:italic;
    font-size:.9rem;
}

/* BUTTONS */

button{
    margin-top:15px;
    margin-right:10px;
    border:none;
    padding:13px 22px;
    border-radius:50px;
    cursor:pointer;
    font-size:1rem;
    font-weight:600;
    transition:.3s;
    color:white;
}

button:first-of-type{
    background:linear-gradient(135deg,#ff416c,#ff4b2b);
}

button:last-of-type{
    background:linear-gradient(135deg,#2563eb,#06b6d4);
}

button:hover{
    transform:translateY(-5px);
    box-shadow:0 10px 20px rgba(0,0,0,.35);
}

button:active{
    transform:scale(.95);
}

button span{
    margin-left:5px;
}

/* RESPONSIVO */

@media(max-width:900px){

article{
    grid-template-columns:1fr;
}

article img{
    height:260px;
}

header h1{
    font-size:2.5rem;
}

}

@media(max-width:500px){

header{
    padding:50px 15px;
}

header h1{
    font-size:2rem;
}

article div{
    padding:20px;
}

article h2{
    font-size:1.4rem;
}

button{
    width:100%;
    margin-right:0;
}

}