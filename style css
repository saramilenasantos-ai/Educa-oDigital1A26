@import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Poppins:wght@300;400;500&display=swap');

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    font-family:Poppins,sans-serif;
    background:#09090f;
    background-image:
        radial-gradient(circle at top left,#6d28d950,transparent 35%),
        radial-gradient(circle at bottom right,#06b6d450,transparent 35%);
    color:#f8fafc;
}

header{
    text-align:center;
    padding:70px 20px;
}

header h1{
    font-family:Orbitron,sans-serif;
    font-size:3.2rem;
    color:#00e5ff;
    text-shadow:0 0 15px #00e5ff;
}

header p{
    margin-top:15px;
    color:#d1d5db;
}

main{
    width:90%;
    max-width:1100px;
    margin:auto;
    display:grid;
    gap:35px;
    padding-bottom:80px;
}

article{
    display:grid;
    grid-template-columns:320px 1fr;
    background:#14141f;
    border:2px solid #6d28d9;
    border-radius:20px;
    overflow:hidden;
    transition:.4s;
}

article:hover{
    transform:translateY(-10px);
    border-color:#00e5ff;
    box-shadow:0 0 30px #00e5ff55;
}

article img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

article:hover img{
    transform:scale(1.08);
}

article div{
    padding:25px;
}

article h2{
    color:#00e5ff;
    margin-bottom:10px;
}

.artigo-autor{
    color:#a78bfa;
    margin-bottom:18px;
    font-weight:bold;
}

article p{
    line-height:1.7;
}

.artigo-fonte{
    margin-top:18px;
}

.artigo-fonte a{
    color:#22d3ee;
    text-decoration:none;
}

.artigo-fonte a:hover{
    color:white;
}

button{
    margin-top:20px;
    padding:12px 20px;
    border:none;
    border-radius:50px;
    background:#6d28d9;
    color:white;
    cursor:pointer;
    font-size:16px;
    transition:.3s;
    margin-right:10px;
}

button:hover{
    background:#00bcd4;
    color:#000;
    transform:scale(1.08);
}

.btn-tema-escuro{
    position:fixed;
    right:25px;
    bottom:25px;
    width:65px;
    height:65px;
    border-radius:50%;
    background:#00e5ff;
    color:#000;
    font-size:28px;
    box-shadow:0 0 25px #00e5ff;
}

.btn-tema-escuro:hover{
    transform:rotate(180deg);
}

@media(max-width:850px){

article{
    grid-template-columns:1fr;
}

article img{
    height:240px;
}

header h1{
    font-size:2.4rem;
}

}